# WinkBench — Environment Configuration Template
# DO NOT COMMIT SENSITIVE VALUES OR ACTUAL SECRETS TO SOURCE CONTROL

# Public Application URL (Hostinger or local preview)
NEXT_PUBLIC_APP_URL=https://winkbench.com

# Firebase Client Configuration (Firebase Console -> Project Settings -> General -> Web App)
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=winkbench.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=winkbench
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=winkbench.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Firebase Admin SDK Credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# In production on Hostinger, place the service account JSON outside public directory
FIREBASE_ADMIN_PROJECT_ID=winkbench
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk@winkbench.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----"

# Node Runtime
NODE_ENV=production
PORT=3000
