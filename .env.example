# Hostinger MySQL Database Configuration
# NOTE: Do NOT assume host is localhost. Use the exact host provided in Hostinger hPanel.
DATABASE_HOST=
DATABASE_PORT=3306
DATABASE_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_SSL=false

# Application Security & Session Secrets
SESSION_SECRET=
NEXT_PUBLIC_APP_URL=https://winkbench.com

# Administrative Route Secret (for non-obvious admin entry URL)
ADMIN_SECRET_SLUG=
